{
  "name": "action-ehr-inspired-access-baseline",
  "version": "1.0.0",
  "description": "ACTION-EHR-inspired patient-centric blockchain access-control baseline — end-to-end cross-institution access authorization + verification latency on Sui Devnet (academic baseline for zkEHR evaluation)",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "deploy:devnet": "bash scripts/deploy_devnet.sh",
    "experiment:create-grant": "node dist/index.js create-grant",
    "experiment:verify-grant": "node dist/index.js verify-grant",
    "experiment:e2e": "node dist/index.js e2e",
    "experiment:all": "node dist/index.js all"
  },
  "dependencies": {
    "@mysten/sui": "^1.45.2",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "typescript": "^5.6.3"
  }
}
