# --- Sui Devnet wiring (REQUIRED, NO LOCAL-ONLY MODE) ----------------------

# This baseline only runs on Sui Devnet. The code refuses to start otherwise.
SUI_NETWORK=devnet
SUI_RPC_URL=https://fullnode.devnet.sui.io:443

# Bech32 `suiprivkey1...` exported by `sui keytool export`. Pays gas for
# every grant-creation tx and is treated as the patient signer for the
# experiment. NEVER commit your real value.
SUI_PRIVATE_KEY=your_patient_sui_private_key_for_gas_and_grant_creation

# Set this AFTER running `npm run deploy:devnet`. The deploy script prints the
# publish package id; paste it here.
SUI_PACKAGE_ID=your_deployed_access_grant_package_id

# --- Experiment knobs ------------------------------------------------------

RUNS=100
WARMUP_RUNS=10
OUTPUT_DIR=results

# --- Cross-institution actor ids baked into every AccessGrant -------------

PATIENT_ID=patient_001
HOSPITAL_A_ID=hospital_A
# 32-byte Sui address. Real value placeholder; the verifier checks bytes equal,
# not authentication, so any well-formed address works for the latency study.
HOSPITAL_A_ADDRESS=0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
HOSPITAL_B_ID=hospital_B
HOSPITAL_B_ADDRESS=0xbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
DEFAULT_EHR_RECORD_ID=ehr_record_001
DEFAULT_SCOPE=read
DEFAULT_EXPIRATION_SECONDS=3600

# --- Local stores ---------------------------------------------------------

STORE_GRANTS_IN=data/access_grants.json
STORE_REQUESTS_IN=data/access_requests.json
