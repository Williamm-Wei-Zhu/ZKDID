# =============================================================================
# Private-key DID/VC on Sui Devnet — configuration
# =============================================================================

# Network must be devnet. Code refuses to run otherwise.
SUI_NETWORK=devnet
SUI_RPC_URL=https://fullnode.devnet.sui.io:443

# Gas-paying key for the patient wallet that signs DID-registration tx.
# Format: a Sui CLI exported `suiprivkey1...` bech32 string OR a 32-byte hex
# secret prefixed with `0x`. NEVER commit a real key to git.
# Generate one with: sui keytool generate ed25519 --json
SUI_PRIVATE_KEY=

# Filled in by `npm run deploy:devnet` (or paste manually after publish).
SUI_PACKAGE_ID=

# Experiment parameters
RUNS=100
WARMUP_RUNS=10
OUTPUT_DIR=results

DID_METHOD=did:sui

# Where wallets / DIDs from prior establishment runs are persisted so the
# auth experiment can reuse them. ACADEMIC ARTIFACTS — do not use in prod.
STORE_KEYS_IN=data/wallets.json
STORE_DIDS_IN=data/dids.json

# Mode 3: VC issuance + verification. Off by default since it is not part
# of the headline identity-establishment latency.
ENABLE_VC_EXPERIMENT=false
