# =============================================================================
# OIDC-ONLY BASELINE CONFIGURATION
# =============================================================================
# Copy to `.env` and fill in your provider credentials.
# Two reference setups are documented at the bottom of this file:
#   (A) Google OIDC — reuses the OAuth client zkEHR already uses (recommended)
#   (B) Local Keycloak — for fully reproducible measurement without Google
# =============================================================================

# Issuer URL (must exactly match the `iss` claim in the ID token)
OIDC_ISSUER=https://accounts.google.com

# Standard OIDC endpoints. Made explicit so the measurement does not depend on
# a discovery round-trip on the critical path.
OIDC_AUTHORIZATION_ENDPOINT=https://accounts.google.com/o/oauth2/v2/auth
OIDC_TOKEN_ENDPOINT=https://oauth2.googleapis.com/token
OIDC_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs

# -----------------------------------------------------------------------------
# Relying-party credentials.
# Reusing the zkEHR Google OAuth client (from
# zklogin/polymedia-zklogin-demo/web/src/config.json → CLIENT_ID_GOOGLE) so
# the baseline runs against the same Google project that zkEHR is registered
# with.
# -----------------------------------------------------------------------------
OIDC_CLIENT_ID=1097270208419-gpj4s5u9tcf76mblvrf0ehlotjifs08o.apps.googleusercontent.com

# zkEHR uses Google's IMPLICIT flow (response_type=id_token) which does NOT
# require a client_secret. This OIDC-only baseline uses the AUTHORIZATION
# CODE flow with PKCE, which Google's "Web application" client type DOES
# require a secret for at the token endpoint.
#
# Two paths to fill this in:
#
#   (1) Recommended — retrieve the secret from Google Cloud Console:
#       Console → APIs & Services → Credentials → click the OAuth 2.0
#       Client "1097270208419-gpj4s5u9tcf76mblv..." → "Client secret"
#       (visible after clicking "Show client secret"). Paste it below.
#
#   (2) Alternative — create a new OAuth 2.0 Client of type "Desktop app".
#       Desktop clients don't require a secret when used with PKCE. Replace
#       OIDC_CLIENT_ID above with the new client's ID and leave this blank.
#
# If you leave this blank and the client is a "Web application" type, the
# token endpoint will reject with HTTP 401 "invalid_client" — the baseline
# will record those as failed runs in the CSV with a clear error message.
OIDC_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Redirect URI must EXACTLY match a URI already registered with the OAuth
# client. zkEHR registered `http://localhost:1234` (root path) — see
# zklogin/.../auth.ts:435 (redirect_uri = window.location.origin). The local
# callback server in this baseline binds to the same URL.
# -----------------------------------------------------------------------------
OIDC_REDIRECT_URI=http://localhost:1234

# Standard OIDC scopes (matches zkEHR's `Google: "openid profile email"`).
OIDC_SCOPE=openid email profile

# Test account label (only used in error messages; not actually used for login
# because Google's session comes from the persistent Chromium profile).
OIDC_TEST_USERNAME=
OIDC_TEST_PASSWORD=

# Experiment parameters
RUNS=100
WARMUP_RUNS=10
OUTPUT_CSV=results/oidc_only_results.csv

# Browser visibility for Playwright (HEADLESS=true keeps Chromium attached
# to the DCV X server but doesn't paint windows — what you want for batch
# measurement).
HEADLESS=true

# JWKS caching strategy:
#   true  -> fetch JWKS once and reuse (typical production behavior)
#   false -> fetch JWKS for every run (worst-case cold-cache measurement)
CACHE_JWKS=true

# Manual login mode: open a visible browser EVERY measured run so the operator
# can sign in by hand. Only useful for debugging — for real 100-run runs use
# the prelogin workflow instead.
MANUAL_LOGIN=false

# Persistent Chromium profile dir (matches the zkEHR experiments pattern).
# Created by `./run-in-dcv.sh prelogin` and reused by every measured run so
# Google's OAuth redirects are silent (cached session cookie).
CHROME_PROFILE_DIR=.chrome-profile

# Provider hint for Playwright selectors. One of: google | keycloak | generic
OIDC_PROVIDER_KIND=google

# Local callback server port (must match the port in OIDC_REDIRECT_URI).
# zkEHR's frontend ALSO uses port 1234 (Vite dev server). Stop the zkEHR
# dev stack before running OIDC-only experiments, or change BOTH the
# OIDC_REDIRECT_URI and CALLBACK_PORT to a free port AND add that URI to
# the OAuth client's "Authorized redirect URIs" in Google Cloud Console.
CALLBACK_PORT=1234

# =============================================================================
# (A) Google OIDC — reuses the zkEHR OAuth client (default above)
# =============================================================================
# Already configured at the top of this file. The only thing missing is the
# client_secret; see comments next to OIDC_CLIENT_SECRET above.

# =============================================================================
# (B) Local Keycloak — alternative for fully-reproducible measurement
# =============================================================================
# OIDC_ISSUER=http://localhost:8080/realms/oidc-baseline
# OIDC_AUTHORIZATION_ENDPOINT=http://localhost:8080/realms/oidc-baseline/protocol/openid-connect/auth
# OIDC_TOKEN_ENDPOINT=http://localhost:8080/realms/oidc-baseline/protocol/openid-connect/token
# OIDC_JWKS_URI=http://localhost:8080/realms/oidc-baseline/protocol/openid-connect/certs
# OIDC_CLIENT_ID=oidc-only
# OIDC_CLIENT_SECRET=<from-keycloak>
# OIDC_REDIRECT_URI=http://localhost:8765/callback
# OIDC_PROVIDER_KIND=keycloak
# CALLBACK_PORT=8765
