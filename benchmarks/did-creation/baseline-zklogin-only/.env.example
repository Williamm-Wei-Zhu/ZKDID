# =============================================================================
# zkLogin-only baseline configuration
# =============================================================================

# --- Sui ---
SUI_NETWORK=devnet
SUI_RPC_URL=https://fullnode.devnet.sui.io:443
# Reuses the did_registry Move package deployed by the private-key baseline.
# Each measured run creates one DIDObject under the zkLogin address.
SUI_PACKAGE_ID=0x64dd915fb8e5bff5b79a9e5e2ea3880588e054aa03630b47e7f43c5d48c1091b
# Gas-sponsor key (same funded key the OIDC-only and private-key baselines use).
# Pays gas on behalf of the zkLogin address via sponsored transaction.
SUI_PRIVATE_KEY=

# --- Google OIDC (zkLogin implicit flow, response_type=id_token) ---
# Reuses the OAuth client from zklogin/polymedia-zklogin-demo/web/src/config.json.
OIDC_CLIENT_ID=1097270208419-gpj4s5u9tcf76mblvrf0ehlotjifs08o.apps.googleusercontent.com
# Must match an authorized redirect URI registered with the OAuth client.
OIDC_REDIRECT_URI=http://localhost:1234
CALLBACK_PORT=1234

# --- zkLogin prover ---
# Mysten Labs' Devnet prover (same endpoint zkEHR uses).
ZK_PROVER_URL=https://prover-dev.mystenlabs.com/v1

# Sui epoch lookahead used by zkLogin (max_epoch = current_epoch + delta).
# Matches the polymedia-zklogin-demo default of 8.
MAX_EPOCH_DELTA=8

# --- Salt (single-authority) ---
# Server-side secret used to derive deterministic salts from {sub|aud}.
# Single source = single-authority salt (this is the *baseline*, not zkEHR's
# multi-authority innovation). NEVER share or commit this value.
SALT_SECRET=academic-baseline-salt-secret-do-not-deploy

# --- Experiment ---
RUNS=100
WARMUP_RUNS=10
OUTPUT_DIR=results

# --- Browser ---
CHROME_PROFILE_DIR=.chrome-profile
HEADLESS=true
MANUAL_LOGIN=false

# --- Persistence (academic only -- not encrypted) ---
STORE_SESSIONS_IN=data/sessions.json
