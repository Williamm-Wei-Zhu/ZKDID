{
  "name": "private-key-did-vc-sui-devnet",
  "version": "1.0.0",
  "description": "Private-key DID/VC baseline on Sui Devnet — academic baseline for zkEHR evaluation",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "deploy:devnet": "bash scripts/deploy_devnet.sh",
    "experiment:establish": "node dist/index.js establish",
    "experiment:auth": "node dist/index.js auth",
    "experiment:vc": "node dist/index.js vc",
    "experiment:all": "node dist/index.js all"
  },
  "dependencies": {
    "@mysten/sui": "^1.45.2",
    "@noble/hashes": "^1.5.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "typescript": "^5.6.3"
  }
}
