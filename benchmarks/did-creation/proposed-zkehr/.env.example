# =============================================================================
# zkEHR-protocol-harness configuration
# =============================================================================
# Apples-to-apples Node.js measurement of zkEHR's protocol layer.
# All on-chain operations target Sui Devnet; OIDC uses Google with persistent
# Chromium profile (silent SSO via prompt=none).

# --- Sui ---
SUI_NETWORK=devnet
SUI_RPC_URL=https://fullnode.devnet.sui.io:443
# Same did_registry Move package the private-key DID and zkLogin-only baselines use.
SUI_PACKAGE_ID=0x64dd915fb8e5bff5b79a9e5e2ea3880588e054aa03630b47e7f43c5d48c1091b
# Gas-sponsor key. zkLogin user pays no gas; this key co-signs every tx.
SUI_PRIVATE_KEY=

# --- Google OIDC (zkLogin implicit flow) ---
OIDC_CLIENT_ID=1097270208419-gpj4s5u9tcf76mblvrf0ehlotjifs08o.apps.googleusercontent.com
OIDC_REDIRECT_URI=http://localhost:1234
CALLBACK_PORT=1234

# --- zkLogin prover ---
ZK_PROVER_URL=https://prover-dev.mystenlabs.com/v1
MAX_EPOCH_DELTA=8

# --- Multi-authority salt (zkEHR's defining feature) ---
# Comma-separated list of salt-service base URLs. Default points at the 4
# institutional services running on EC2 (pm2-managed: salt-inst-1..salt-inst-4).
# Each service exposes POST /get-salt taking {jwt} -> {salt, computeMs},
# matching polymedia-zklogin-demo/web/src/lib/saltClient.ts.
SALT_INSTITUTIONS=http://localhost:7001,http://localhost:7002,http://localhost:7003,http://localhost:7004

# --- Experiment ---
RUNS=100
WARMUP_RUNS=10
OUTPUT_DIR=results

# --- Browser ---
CHROME_PROFILE_DIR=.chrome-profile
HEADLESS=true
MANUAL_LOGIN=false

# --- Persistence (academic only -- not encrypted) ---
STORE_SESSIONS_IN=data/sessions.json
